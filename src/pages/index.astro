---
import "../css/styles.css";
import axios from "axios";

const token = import.meta.env.GITHUB_TOKEN;

let reposData: any[] = [];
let contributorsData: any[] = [];

try {
  const repos = await axios.get(
    "https://api.github.com/users/cmsrwood/repos?sort=updated&per_page=12&type=public",
    { headers: { Authorization: `Bearer ${token}` } }
  );
  reposData = repos.data.filter((r: any) => !r.fork);

  const promises = reposData.map((repo: any) =>
    axios.get(repo.contributors_url, {
      headers: { Authorization: `Bearer ${token}` },
    })
  );
  contributorsData = await Promise.allSettled(promises);
} catch (_) {
  // GitHub API unavailable en build — repos vacíos, resto del sitio funciona
}

const SKILLS: Record<string, string[]> = {
  "Frontend": ["React", "TypeScript", "Astro", "Tailwind CSS", "Next.js", "Vite"],
  "Backend": ["Node.js", "Express", "REST APIs", "WebSockets"],
  "Cloud & AWS": ["AWS Amplify", "Lambda", "Amazon Connect", "DynamoDB", "S3", "Lex v2"],
  "Herramientas": ["Git", "GitHub", "VS Code", "DaisyUI"],
};

const FEATURED = [
  {
    title: "IU Digital — Virtual Agent",
    desc: "Agente virtual omnicanal con Amazon Lex v2. Flujos de escalamiento a agente humano, Customer Profiles y atención automatizada.",
    tags: ["AWS Lex v2", "React", "Lambda", "DynamoDB"],
    gradient: "from-blue-500/20 to-cyan-700/20",
    icon: "🤖",
    link: null,
  },
  {
    title: "Landing Pages · Bogotá",
    desc: "10 landing pages para negocios tech en Bogotá. React + Vite + Tailwind con SEO avanzado: JSON-LD, Open Graph, geo tags y Core Web Vitals.",
    tags: ["React", "Vite", "Tailwind CSS", "SEO"],
    gradient: "from-emerald-500/20 to-teal-700/20",
    icon: "🚀",
    link: null,
  },
];

const SERVICES = [
  {
    icon: "⚡",
    title: "Landing Pages",
    desc: "Páginas rápidas, optimizadas para SEO y conversión. Diseño único, mobile-first, con métricas de Core Web Vitals en verde.",
  },
  {
    icon: "🌐",
    title: "Desarrollo Web",
    desc: "Aplicaciones web modernas con React, TypeScript y Node.js. Desde el diseño hasta el despliegue en AWS.",
  },
  {
    icon: "☁️",
    title: "Soluciones AWS",
    desc: "Contact centers con Amazon Connect, agentes de voz e IA, arquitecturas serverless y flujos automatizados.",
  },
];
